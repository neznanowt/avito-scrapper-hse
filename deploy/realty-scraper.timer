# /etc/systemd/system/realty-scraper.timer
# Включение: sudo systemctl daemon-reload && sudo systemctl enable --now realty-scraper.timer
# Проверка:  systemctl list-timers realty-scraper.timer; journalctl -u realty-scraper -n 100
[Unit]
Description=Ночной запуск сбора объявлений

[Timer]
OnCalendar=*-*-* 23:30:00 Europe/Moscow
RandomizedDelaySec=20min
Persistent=true

[Install]
WantedBy=timers.target
